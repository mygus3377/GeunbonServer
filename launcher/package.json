{
  "name": "server-launcher",
  "version": "1.1.0",
  "description": "Geunbon Server Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "electron"
  ],
  "author": "Geunbon",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.6.8",
    "minecraft-launcher-core": "^3.2.2",
    "msmc": "^3.1.5"
  },
  "devDependencies": {
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.geunbon.launcher",
    "productName": "Geunbon Launcher",
    "files": [
      "main.js",
      "self_update.js",
      "preload.js",
      "renderer.js",
      "github_sync.js",
      "config.js",
      "resourcepacks.js",
      "extras.js",
      "gdrive_sync.js",
      "index.html",
      "style.css",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "icon.png"
    },
    "directories": {
      "output": "dist"
    }
  }
}